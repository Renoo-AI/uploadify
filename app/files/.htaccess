# Disable execution of scripts in this directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|sh|exe|jsp|asp|aspx|py)$">
    SetHandler None
    Require all denied
</FilesMatch>

# Force download for specific types or just disable MIME sniffing
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Prevent directory listing
Options -Indexes
